[Unit]
Description=Fountain Composer Attachment Cloud
After=network-online.target fountain-image-cloud.service
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/var/lib/fountain-composer/current
ExecStart=/var/lib/fountain-composer/current/.build/release/fountain-composer-cloud-server
Environment=FOUNTAIN_COMPOSER_PORT=8789
Environment=FOUNTAIN_COMPOSER_ROOT=/var/lib/fountain-composer/attachments
EnvironmentFile=/etc/fountain-image-cloud/image-cloud.env
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/var/lib/fountain-composer/attachments

[Install]
WantedBy=multi-user.target
